doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Wallet AS
    style.
      :root { color-scheme: light; }
      body {
        margin: 0;
        min-height: 100vh;
        font-family: "Helvetica Neue", Arial, sans-serif;
        background: radial-gradient(circle at 20% 20%, #f8f9fb, #e7ecf5);
        color: #1a1f36;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      main {
        max-width: 560px;
        padding: 32px 40px;
        border-radius: 18px;
        box-shadow: 0 12px 50px rgba(26, 31, 54, 0.08);
        background: #ffffff;
      }
      h1 {
        margin: 0 0 12px;
        font-size: 32px;
        letter-spacing: -0.02em;
      }
      p {
        margin: 0 0 16px;
        line-height: 1.55;
        color: #4d5675;
      }
  body
    main
      h1 Hello from Wallet AS
