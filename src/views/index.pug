doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    base(href=baseUrl + '/')
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Wallet AS
    link(rel="stylesheet", href="styles/base.css")
    link(rel="stylesheet", href="styles/index.css")

  body
    main.home
      header.home__header
        h1.home__title Wallet Authorization Server
        p.home__subtitle
          | Secure authentication and authorization services for Wallet clients.

      section.home__content
        p
          | This service provides OpenID Connect and OAuth 2.0 flows used by
          | trusted wallet applications and relying parties.

        ul.home__list
          li Client authentication & consent handling
          li Secure login and session management
          li Standards-compliant OpenID Connect endpoints

      footer.home__footer
        p
          | © #{new Date().getFullYear()} Wallet AS
