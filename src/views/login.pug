doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    base(href=baseUrl + '/')
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Wallet AS · Sign in
    link(rel="stylesheet", href="styles/base.css")
    link(rel="stylesheet", href="styles/login.css")

  body
    - const clientName = (client.clientId || client.client_id || 'Client');
    - const clientInitial = (clientName && clientName.trim().charAt(0).toUpperCase()) || 'C';

    .login-page
      .login-header
        .login__logo-circle
          if client.logoUri
            img.login__logo-img(
              src=client.logoUri,
              alt=clientName + ' logo',
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
            )
            .login__logo-fallback #{clientInitial}
          else
            .login__logo-fallback(style="display:flex") #{clientInitial}

        h1.login__title Sign in
        p.login__subtitle
          | Continue to&nbsp;
          strong #{clientName}

      main.login
        if error
          p.login__error #{error}

        if demoMode
          span.login__demo Demo Mode is ON. Test user credentials have been prefilled.
        form.login__form(method="post", action=`interaction/${uid}/login`)
          input(type="hidden", name="uid", value=uid)

          .login__field-group
            label.login__label(for="login") Username or email
            input.login__input(
              type="text",
              name="login",
              id="login",
              autocomplete="username",
              required=true,
              value=demoMode ? demoUsername : login,
              placeholder="Enter your username or email"
            )

          .login__field-group
            label.login__label(for="password") Password
            input.login__input(
              type="password",
              name="password",
              id="password",
              autocomplete="current-password",
              required=true,
              placeholder="Enter your password"
              value=demoMode ? demoPassword : ""
            )

          button.login__submit(type="submit") Sign in

        if allowPidAuth
          .login__divider
            span.login__divider-text or

          form.login__form(method="post", action=`interaction/${uid}/pid`)
            input(type="hidden", name="uid", value=uid)

            button.login__submit.login__submit--secondary(type="submit")
              span.login__btn-icon(aria-hidden="true")
              | Sign in with PID
