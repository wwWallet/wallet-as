{
  "name": "wallet-as",
  "version": "0.0.1",
  "description": "A standalone AS for wwWallet",
  "main": "app.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "DEBUG=oidc-provider:* ts-node-dev --respawn --transpile-only src/app.ts",
    "start": "node dist/app.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:unit": "vitest test/unit/*.test.ts",
    "test:integration": "vitest test/integration/*.test.ts --config vitest.integration.config.ts"
  },
  "author": "",
  "license": "BSD-2-Clause",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.2",
    "@types/oidc-provider": "^9.13.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.0.0",
    "prettier": "^3.8.0",
    "supertest": "^7.3.0",
    "testcontainers": "^12.2.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "iovalkey": "^0.3.3",
    "oidc-provider": "^9.13.3",
    "openid-client": "^6.8.2",
    "pug": "^3.0.3",
    "wallet-common": "git+https://github.com/wwWallet/wallet-common.git#v1.0.0",
    "zod": "^4.3.6"
  }
}
